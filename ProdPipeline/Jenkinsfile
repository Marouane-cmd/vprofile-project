pipeline {
    agent any
    tools {
        maven "MAVEN3"
        jdk "JDK17"
    }
    
    environment {
        cluster = "vproappprod"
        service = "vproapptask-service-prod"
    }

    stages {
        stage('Deploy TO Prod ECS') {
            steps {
                withAWS(credentials: 'awscreds', region: 'us-east-2') {
                  sh """
                    aws ecs update-service \
                    --cluster ${cluster} \
                    --service ${service} \
                    --force-new-deployment
                  """
               }
           }
        }
             
    }

    post {
        always {
            echo 'Slack Notification wird gesendet...'
            slackSend(
                channel: '#deployments',  
                color: currentBuild.result == 'SUCCESS' ? 'good' : 'danger',
                message: "Build ${currentBuild.displayName} - ${currentBuild.result}\nJob: ${env.JOB_NAME}\nBuild: ${env.BUILD_NUMBER}\nURL: ${env.BUILD_URL}"
            )
            echo 'Pipeline abgeschlossen - Ergebnis: ${currentBuild.result}'
        }
        success {
            echo 'Pipeline war erfolgreich!'
        }
        failure {
            echo 'Pipeline ist fehlgeschlagen!'
        }
        unstable {
            echo 'Pipeline ist instabil!'
        }
    }
    
    
}